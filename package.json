{
  "name": "daynight-theme-scheduler",
  "displayName": "DayNight Theme Scheduler",
  "description": "Automatically switch VS Code themes based on configured time ranges.",
  "version": "0.1.1",
  "publisher": "alevis",
  "license": "MIT",
  "icon": "icon.jpg",
  "galleryBanner": {
    "color": "#102e43",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alevis/daynight.git"
  },
  "homepage": "https://github.com/alevis/daynight#readme",
  "bugs": {
    "url": "https://github.com/alevis/daynight/issues"
  },
  "keywords": [
    "vscode",
    "theme",
    "scheduler",
    "time-based",
    "automation",
    "appearance"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Themes",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:daynight.openScheduler"
  ],
  "main": "./src/extension.js",
  "files": [
    ".vscode",
    "fonts",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "icon.jpg",
    "screenshot.png"
  ],
  "contributes": {
    "commands": [
      {
        "command": "daynight.openScheduler",
        "title": "DayNight: Open Theme Scheduler"
      }
    ],
    "configuration": {
      "title": "DayNight Theme Scheduler",
      "properties": {
        "daynight.applyOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "Apply the matching scheduled theme when VS Code starts."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm test",
    "test": "node --test src/test/*.test.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0"
  }
}
